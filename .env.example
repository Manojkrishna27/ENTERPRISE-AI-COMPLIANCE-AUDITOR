# AI Provider Keys
OPENAI_API_KEY=your_gemini_or_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/contract_compliance

# Vector DB Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# FastAPI Backend Configuration
FASTAPI_ENV=production
SECRET_KEY=change-this-in-production-12345
JWT_SECRET_KEY=change-this-jwt-secret-in-production-12345
PORT=5000

# File Storage Configuration
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=/app/uploads

# Frontend Configuration
VITE_API_URL=/api
