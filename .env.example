# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/contract_compliance

# Qdrant Vector DB Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# OpenAI API Settings
OPENAI_API_KEY=your-openai-api-key-here

# File Storage Configuration
# Set USE_LOCAL_STORAGE=true to save uploaded files in a local directory instead of AWS S3
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=/app/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1

# Mail Configuration (optional/fallback)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@contractcompliance.com
